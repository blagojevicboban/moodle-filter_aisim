{{!
    @template filter_aisim/slider

    A labelled range slider with its current value, used by the simulation layouts.

    Context variables required for this template:
    * id - element id of the input; the value span gets id-val
    * label - text before the value
    * text - value as shown
    * value, min, max, step - slider settings

    Example context (json):
    {
        "id": "aisim-db-n",
        "label": "Sample size",
        "value": 200,
        "text": "200",
        "min": 40,
        "max": 400,
        "step": 20
    }
}}
<div class="aisim-slider-group">
    <label for="{{id}}">{{label}} = <span id="{{id}}-val">{{text}}</span></label>
    <input type="range" class="aisim-slider" id="{{id}}" min="{{min}}" max="{{max}}" step="{{step}}"
           value="{{value}}">
</div>
